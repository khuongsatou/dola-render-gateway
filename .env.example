# Dola Render Gateway Configuration
DOLA_HOST=0.0.0.0
DOLA_PORT=8000

# Proxy with JP/KR egress (required for accessing Dola services from restricted regions)
DOLA_PROXY=http://127.0.0.1:7890

# API Keys for client auth (comma-separated; empty = dev mode / no auth)
DOLA_API_KEYS=

# Admin web dashboard password (empty = no auth)
DOLA_ADMIN_KEY=

# Max concurrent video generation tasks
DOLA_MAX_CONCURRENCY=3

# Headless browser mode (1 = headless, 0 = visible browser)
DOLA_HEADLESS=1

# Video timeout in seconds
DOLA_VIDEO_TIMEOUT=300
