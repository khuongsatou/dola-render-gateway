# Dola Render Gateway Configuration
DOLA_HOST=0.0.0.0
DOLA_PORT=8000

# Proxy with JP/KR egress (required for accessing Dola services from restricted regions)
DOLA_PROXY=http://127.0.0.1:7890

# API Keys for client auth (required unless DOLA_ALLOW_UNAUTHENTICATED=1)
DOLA_API_KEYS=

# Admin web dashboard password (required unless DOLA_ALLOW_UNAUTHENTICATED=1)
DOLA_ADMIN_KEY=

# Explicit opt-in for unauthenticated local development. Requires a loopback
# DOLA_HOST and must never be enabled on a reachable host.
DOLA_ALLOW_UNAUTHENTICATED=0

# Reference image download limits (bytes / files / concurrent downloads)
DOLA_REFERENCE_IMAGE_MAX_BYTES=15728640
DOLA_REFERENCE_IMAGE_MAX_TOTAL_BYTES=62914560
DOLA_REFERENCE_TEMP_BUDGET_BYTES=536870912
DOLA_REFERENCE_DOWNLOAD_CONCURRENCY=4

# Longest accepted generation prompt
DOLA_PROMPT_MAX_LENGTH=4000

# Lifetime of signed /videos/<file> links handed to the dashboard (seconds)
DOLA_MEDIA_TOKEN_TTL=3600

# Max concurrent video generation tasks
DOLA_MAX_CONCURRENCY=3

# Headless browser mode (1 = headless, 0 = visible browser)
DOLA_HEADLESS=1

# Incognito browser mode (1 = incognito enabled, 0 = disabled, default: 0)
DOLA_INCOGNITO=0

# Video timeout in seconds
DOLA_VIDEO_TIMEOUT=300
